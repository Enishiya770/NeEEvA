# ===== Unity generated =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider cache
.vs/
.idea/
.vsconfig

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ===== Project local =====
# Bundled GPT-SoVITS runtime + models (~12GB, far beyond GitHub limits).
# Keep the start script tracked so cloners see how the server is launched.
/GPT-SoVITS/*
!/GPT-SoVITS/start_tts_server.bat
# User-created singing clips are private runtime data, never source assets.
/Server/SenseVoice/song_library/
/Server/SenseVoice/song_catalog.json
/Server/SenseVoice/runtime/
/Server/RuntimeLogs/
**/__pycache__/
*.py[cod]
# Claude Code local session config
.claude/
# Local API key backup (removed from scenes before publishing)
LOCAL_API_KEYS.backup.txt
# Stray empty git-init leftover folder
/git/
# Local Seed-VC runtime dependencies and downloaded model weights
Server/SeedVC/python_packages/
Server/SeedVC/vendor/
Server/SeedVC/local_models/
Server/SeedVC/**/__pycache__/
Server/SeedVC/test_headers.txt
Server/SeedVC/test_output.wav
Server/SeedVC/last_conversion/
Server/SeedVC/runtime/
Server/SeedVC/quality_headers.txt
Server/SeedVC/quality_output.wav
Server/SeedVC/ab_*.wav
Server/SVS/.venv/
Server/SVS/vendor/
# DiffSinger 日语渲染器：音源与声码器权重约 1.4GB，按官方渠道重新下载即可
Server/DiffSinger/.venv/
Server/DiffSinger/voicebank/
Server/DiffSinger/vocoder/
Server/DiffSinger/runtime/
Server/DiffSinger/*.zip
Server/DiffSinger/*.oudep
Server/SVS/last_synthesis/
Server/SVS/runtime/
Server/RVC/vendor/
Server/RVC/.venv/
# 手工下载的 torch wheel 缓存（约 2.7GB）
Server/RVC/.wheels/
# 曲库目录的本地备份
Server/SenseVoice/song_catalog.json.bak
Server/RVC/python_packages/
Server/RVC/dataset/
Server/RVC/training_output/
Server/RVC/models/
Server/RVC/quality_*.wav
Server/RVC/parameter_*.wav
Server/RVC/song_covers/
Server/RVC/*_headers.txt
# Local diagnostic reference generated during voice-conversion experiments.
/Assets/Model/41041_svc_anchor.wav
/Assets/Model/41041_svc_anchor.wav.meta
# Incorrect English-sidecar experiment for the older Japanese dialogue clip.
# The checked Mandarin SVS prompt has its own accurate metadata instead.
/Assets/Model/41041.json
/Assets/Model/41041.json.meta
# 边界附近的整轮音频落盘，只用于离线定阈值，不入库
/Server/SenseVoice/band_dumps/
# Local singing/voice diagnostics and recovery snapshots are runtime data.
/Server/SenseVoice/practice_dumps/
/Server/SenseVoice/song_library_removed/
/Server/SenseVoice/song_catalog.*.json
*.bak
*.bak[0-9]*
# 离线类型检查漏写 -out 时会在根目录生成 Assembly-CSharp 的副本（取了第一个源文件名）
/OpenFileName.dll

# Licensed SailingMoon room assets are local-only. The upstream repository is
# public and the room license forbids redistributing original or modified data.
/Assets/Private/
/Assets/Private.meta
/LocalPrivate/
